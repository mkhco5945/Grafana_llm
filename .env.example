# Grafana service-account token used by mcp-grafana to call Grafana.
GRAFANA_MCP_SERVICE_ACCOUNT_TOKEN=replace-with-a-local-grafana-service-account-token

# Bearer token required from local MCP clients.
MCP_GRAFANA_SERVER_TOKEN=replace-with-a-random-local-mcp-caller-token

# Host-side local agent settings. Defaults match this repository's setup.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
MCP_GRAFANA_URL=http://127.0.0.1:8002/mcp
DEMO_API_URL=http://127.0.0.1:8000
DEMO_API_TIMEOUT_SECONDS=10
DEMO_SCRAPE_WAIT_SECONDS=6
OLLAMA_TIMEOUT_SECONDS=900
MCP_TIMEOUT_SECONDS=120
OLLAMA_KEEP_ALIVE=30m
OLLAMA_CONTEXT_SIZE=12288
OLLAMA_NUM_PREDICT=2048
OLLAMA_TEMPERATURE=0.2
OLLAMA_THINKING=false
AGENT_MAX_TOOL_TURNS=20
AGENT_MAX_SAME_TOOL_FAILURES=2
AGENT_MAX_PREWRITE_RECOVERY_BLOCKS=3
AGENT_MAX_PREWRITE_TURNS=12

# Grafana AI app routing. Read-only/data questions use the fast model;
# dashboard creation or modification automatically uses the stronger model.
AI_FAST_MODEL=qwen3:4b
AI_DASHBOARD_MODEL=qwen3:8b
AI_API_HOST=0.0.0.0
AI_API_PORT=8010
